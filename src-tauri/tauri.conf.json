{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Workspace",
  "identifier": "dev.sshworkspace.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSH Workspace",
        "width": 1190,
        "height": 780,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Local SSH and Git identity manager",
    "linux": {
      "deb": {
        "depends": ["git", "openssh-client"]
      }
    }
  }
}
