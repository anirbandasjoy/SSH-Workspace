{
  "name": "vexo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "desktop": "pnpm --filter desktop desktop",
    "desktop:bundle": "pnpm --filter desktop bundle",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  }
}
